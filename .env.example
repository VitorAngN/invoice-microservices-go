# PostgreSQL (usado pelo docker-compose)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=korp

# Rodando os serviços fora do Docker
DB_DRIVER=postgres          # ou "sqlite" para testar sem banco
DATABASE_URL="host=localhost user=user password=password dbname=korp port=5432 sslmode=disable TimeZone=America/Sao_Paulo"
STOCK_SERVICE_URL=http://localhost:8081
